{
  "name": "pstack-codex-release",
  "version": "0.0.0-development",
  "private": true,
  "description": "Release automation for the pstack-codex plugin bundle",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "release": "semantic-release",
